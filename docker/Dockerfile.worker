# Ray Worker Node (Hybrid Python + Node.js)
FROM rayproject/ray:2.9.0-py310

USER root

# Install Node.js 20 and ts-node
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs build-essential && \
    npm install -g ts-node typescript && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps for Ray/RLlib
RUN pip install --no-cache-dir \
    "ray[rllib]" \
    torch \
    gymnasium \
    requests

WORKDIR /app

# Copy dependency definitions
COPY package*.json ./
COPY tsconfig*.json ./

# Install Node dependencies
RUN npm ci

# Copy full source and datasets (including core_set_v2.json)
COPY . .

# Build step (TypeScript to JS)
RUN npm run build:server || true

# Entry point handled by KubeRay
CMD ["ray", "start", "--block"]
