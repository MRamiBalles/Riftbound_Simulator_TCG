
# Ray Worker Node (Hybrid Python + Node.js)
FROM rayproject/ray:2.9.0-py310

User root

# Install Node.js 20
RUN apt-get update && apt-get install -y curl && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs build-essential && \
    rm -rf /var/lib/apt/lists/*

# Install Python deps
RUN pip install --no-cache-dir \
    "ray[rllib]" \
    torch \
    gymnasium \
    stable-baselines3 \
    requests

WORKDIR /app

# Copy Node.js project definition
COPY package*.json ./

# Install Node dependencies
RUN npm ci --only=production

# Copy source code and build scripts
COPY . .

# Build output (assuming dist/ exists or tsc runs)
# Check if build script exists, otherwise assume pre-built
RUN npm run build || true

# Entry point handled by KubeRay
CMD ["ray", "start", "--block"]
